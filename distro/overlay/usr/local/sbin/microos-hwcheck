#!/bin/sh
# microos-hwcheck: what hardware does Micro-OS see on this machine, and which
# driver is handling each device? Run it on the laptop after booting from USB.
. /usr/local/lib/microos/common.sh

section() { printf '\n== %s\n' "$1"; }

echo "Micro-OS Linux stage $STAGE on $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) $(cat /sys/class/dmi/id/product_name 2>/dev/null)"
echo "kernel $(uname -r), CPU: $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ //')"
if [ -d /sys/firmware/efi ]; then
    sb=$(od -An -t u1 /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | awk '{print $NF}')
    echo "firmware: UEFI, Secure Boot $([ "$sb" = 1 ] && echo on || echo off)"
else
    echo "firmware: legacy BIOS"
fi

section "Devices and the drivers bound to them"
if have_lspci=$(command -v lspci); then
    lspci -k | awk '/^[0-9a-f]/ {dev=$0} /Kernel driver in use/ {print dev; print "    " $0}' | sed 's/^\([0-9a-f:.]*\) /\1  /'
else
    echo "(lspci is part of stage 3)"
fi

section "Network"
command -v nmcli >/dev/null && nmcli device status || echo "(NetworkManager is part of stage 1)"
command -v rfkill >/dev/null && { echo; rfkill list; }

section "Graphics"
for c in /sys/class/drm/card[0-9]; do
    [ -e "$c/device/driver" ] && echo "$(basename "$c"): $(basename "$(readlink "$c/device/driver")") ($(cat "$c/device/vendor"))"
done
echo "Note: the NVIDIA RTX 5050 needs driver 570+; Debian 13 ships 550, so it is not used. The Intel GPU drives the display."

section "Audio / Bluetooth / microcode"
[ -d /proc/asound ] && cat /proc/asound/cards
command -v bluetoothctl >/dev/null && bluetoothctl list 2>/dev/null
grep -m1 microcode /proc/cpuinfo
